{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
		// `module` / `moduleResolution` intentionally inherited from $app/tsconfig
		// (esnext + bundler): this lib is only ever consumed through a bundler
		// (Vite/SvelteKit, incl. adapter-node), so bundler resolution matches the
		// real runtime. publint guards packaging for all consumers independently.
	},
	"include": ["src", "vite.config.ts"]
}
